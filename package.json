{
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.8",
    "stremio-addon-sdk": "1.6.10",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/stremio-addon-sdk": "1.6.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "name": "stremio-personalized-feed",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Personalized Stremio feed with weekly trends, fresh releases, Korean, Chinese, Japanese and anime catalogs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx apps/api/main.ts",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "path-to-regexp": "0.1.13",
    "tmp": "0.2.7"
  }
}
