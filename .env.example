PORT=7000
HOST=0.0.0.0
# Set this to the public HTTPS origin when deploying (no trailing slash).
PUBLIC_BASE_URL=http://localhost:7000
DATABASE_URL=file:../data/feed.db
# persistent: requires a durable disk/volume; ephemeral: disposable demo only.
STORAGE_MODE=persistent
LOG_LEVEL=info
# Optional: require an invitation code to create profiles on a public instance.
REGISTRATION_KEY=

# Live data: use your TMDB API Read Access Token (keep private, never commit).
TMDB_READ_ACCESS_TOKEN=
# Alternative to the Bearer token:
TMDB_API_KEY=
# Enable fixtures ONLY for an offline demo. Live fresh/trending rows stay empty in demo.
DEMO_MODE=false
