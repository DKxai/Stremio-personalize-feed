generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  tokenHash    String        @unique
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  preferences  Preference?
  favorites    Favorite[]
  interactions Interaction[]
  library      LibraryEntry[]
  watchedVideos WatchedVideo[]
  lastLibraryEventAt DateTime?
  lastPlayerEventAt DateTime?
}

model Preference {
  userId String @id
  genres String
  feed String @default("{}")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId  String
  mediaId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
}

model Interaction {
  userId    String
  mediaId   String
  kind      String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
}

model ExternalCache {
  key       String   @id
  payload   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model MovieMetadata {
  key       String   @id
  imdbId    String
  type      String
  payload   String
  updatedAt DateTime @updatedAt

  @@index([imdbId, type])
}

model LibraryEntry {
  userId    String
  mediaId   String
  type      String
  saved     Boolean  @default(false)
  watched   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@index([userId, updatedAt])
}

model WatchedVideo {
  userId    String
  mediaId   String
  videoId   String
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([userId, mediaId])
}
